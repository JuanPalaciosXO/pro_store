#------------Usuarios---------------

### Admin
POST {{baseUrl}}/register HTTP/1.1
Content-Type: application/json

{
  "NID_cliente": 123456789,
  "nombre_cliente": "Juan",
  "apellido_cliente": "Lopez",
  "correo_cliente": "juaness@gmail.com",
  "telefono_cliente": 3201112233,
  "direccion_cliente": "Calle 1",
  "password": "123456",
  "rol": "admin"
}

### Cliente
POST {{baseUrl}}/register HTTP/1.1
Content-Type: application/json

{
  "NID_cliente": 123456789,
  "nombre_cliente": "Juan",
  "apellido_cliente": "Lopez",
  "correo_cliente": "juaness@gmail.com",
  "telefono_cliente": 3201112233,
  "direccion_cliente": "Calle 1",
  "password": "123456",
  "rol": "cliente"
}


### Admin
POST {{baseUrl}}/login HTTP/1.1
Content-Type: application/json

{
  "correo_cliente": "juaness@gmail.com",
  "password": "123456"
}

### Cliente
POST {{baseUrl}}/login HTTP/1.1
Content-Type: application/json

{
  "correo_cliente": "juanes@gmail.com",
  "password": "123456"
}

### Perfil
GET {{baseUrl}}/perfil HTTP/1.1
Authorization: Bearer {{tokeCliente}}

### Perfil sin token
GET {{baseUrl}}/perfil HTTP/1.1

#-----------Productos--------------

### Crear producto
POST {{baseUrl}}/products HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokeAdmin}}

{
  "nombre": "Chaqueta Ferrari",
  "descripcion": "Color rojo",
  "precio": 150000,
  "stock": 20
}

###
GET {{baseUrl}}/products HTTP/1.1

###
GET {{baseUrl}}/products/1 HTTP/1.1

### actualizar por id
PUT {{baseUrl}}/products/1 HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokeAdmin}}

{
  "nombre": "Chaqueta Red Bull",
  "descripcion": "Color blanco",
  "precio": 150000,
  "stock": 30
}

### eliminar productos por id
DELETE {{baseUrl}}/products/3 HTTP/1.1
Authorization: Bearer {{tokeAdmin}}

### Pedidos
POST {{baseUrl}}/orders HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{tokeCliente}}

{
  "productos": [
    { "id_producto": 1, "cantidad": 2 },
    { "id_producto": 2, "cantidad": 1 }
  ]
}

### Ver pedido cliente
GET {{baseUrl}}/orders HTTP/1.1
Authorization: Bearer {{tokeCliente}}

### Ver pedidos admin
GET {{baseUrl}}/orders HTTP/1.1
Authorization: Bearer {{tokeAdmin}}

###
GET {{baseUrl}}/orders/1
Authorization: Bearer {{tokeCliente}}

### Estado de paquete
PATCH {{baseUrl}}/orders/1/status HTTP/1.1
Authorization: Bearer {{tokeAdmin}}
Content-Type: application/json

{
  "estado": "pagado"
}




